# ---- Core ----
# Hosted Postgres dev DB (Neon / Render / Railway). Replace before running db:migrate.
DATABASE_URL="postgresql://user:password@host:5432/ace_laundry?schema=public"

# Server
PORT=4000
NODE_ENV=development

# Operator login (v1: single hardcoded credential)
OPERATOR_PASSWORD="change-me"
# Session secret used to sign the operator auth token. Change before going live.
OPERATOR_SESSION_SECRET="dev-operator-session-secret"

# Public base URL of the Next.js app (Flutterwave redirect target + short links)
FRONTEND_URL="http://localhost:3000"

# Business contact number shown to customers (Call/WhatsApp button), Nigerian local format e.g. "08123456789"
BUSINESS_PHONE=""

# ---- Payment gateway: Flutterwave V3 (used from session 2 onwards) ----
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_SECRET_HASH=""
FLUTTERWAVE_ENV="test" # test | live
# The gateway requires a customer email; the product collects none, so charges
# are made under a fixed business address.
FLUTTERWAVE_PAYMENT_EMAIL="payments@example.com"

# ---- Notifications (used from session 4 onwards) ----
# SMS / WhatsApp
TERMII_API_KEY=""
TERMII_SENDER_ID="AceLaundry"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# Email via SendLib (https://sendlib.samueltuoyo.com/api/send).
# Get your key at https://sendlib.samueltuoyo.com. When SL_FROM is blank the
# gateway sends from the first Gmail connected to your SendLib account.
SL_API_KEY=""
SL_FROM=""
# Origin sent on SendLib requests; must be whitelisted for the key in your
# SendLib dashboard (API Keys -> allowed origins).
SL_ORIGIN="http://localhost:4000"
OPERATOR_EMAIL=""
